#!/usr/bin/env bash
# tmux-fingers-open — open a `path|line` citation (or plain path) in nvim.
#
# Wired to tmux-fingers' SHIFT action (@fingers-shift-action). tmux-fingers
# pipes the selected match to this command on STDIN, e.g.
#   kogan3/apps/k3/products/mappings.py|569
# (env also carries $MODIFIER=shift and $HINT=<hint letter>).
#
# Opens nvim in a new tmux window whose cwd is the active pane's cwd, so
# repo-root-relative citations resolve when you're sitting at the repo root.
set -euo pipefail

match="$(cat)"
match="${match%$'\n'}"   # strip a trailing newline, if any
[ -n "$match" ] || exit 0

if [[ "$match" == *"|"* ]]; then
  file="${match%%|*}"
  line="${match##*|}"
else
  file="$match"
  line=1
fi

# `-c "#{pane_current_path}"` — tmux expands the format to the active pane's cwd.
tmux new-window -c "#{pane_current_path}" "nvim +${line} -- \"${file}\""
