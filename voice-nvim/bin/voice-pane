#!/bin/sh
# Split the current tmux window and start claude-voice beside the active pane (your Neovim).
# Focus stays where it is. The new pane is tagged @voice, and F5 is bound (no prefix) in
# this tmux server to talk to it. Nothing is written to your tmux.conf.
# Arguments go to claude-voice: `voice-pane --continue` resumes the last session in this
# directory, `voice-pane --resume` picks one. `voice-pane SESSION_ID` (or `--resume SESSION_ID`)
# resumes that session from any window: the pane starts in the directory the session was
# created in, which is where Claude looks for it.
#   VOICE_PANE_SIZE  width of the new pane, default 38%
#   VOICE_KEY        talk key, default F5 (F4 is left for Claude Code's own push-to-talk)
set -eu
[ -n "${TMUX:-}" ] || { echo "voice-pane: run this inside tmux" >&2; exit 1; }
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
ROOT=$(cd "$(dirname "$self")/.." && pwd)

# Target the pane this runs in, not whichever window tmux considers current.
here=${TMUX_PANE:-}
existing=$(tmux list-panes ${here:+-t "$here"} -F '#{pane_id} #{@voice}' | awk '$2 == "1" { print $1; exit }')
if [ -n "$existing" ]; then
  echo "voice-pane: this window already has one ($existing)" >&2
  exit 0
fi

uuid='[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]'
# A bare session id means --resume it.
if [ $# -gt 0 ]; then
  case $1 in $uuid) set -- --resume "$@" ;; esac
fi

dir='#{pane_current_path}'
for a in "$@"; do
  case $a in $uuid) ;; *) continue ;; esac
  file=
  for f in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/"$a".jsonl; do
    [ -f "$f" ] && { file=$f; break; }
  done
  [ -n "$file" ] || { echo "voice-pane: no Claude session $a" >&2; exit 1; }
  cwd=$(grep -m1 -o '"cwd":"[^"]*"' "$file" | sed 's/^"cwd":"//; s/"$//') || true
  if [ -n "$cwd" ] && [ -d "$cwd" ]; then
    dir=$cwd
  else
    echo "voice-pane: session $a has no usable directory; starting in this pane's" >&2
  fi
  break
done

pane=$(tmux split-window ${here:+-t "$here"} -d -h -l "${VOICE_PANE_SIZE:-38%}" -c "$dir" \
  -P -F '#{pane_id}' "$ROOT/bin/claude-voice" "$@")
tmux set-option -p -t "$pane" @voice 1

# Single quotes matter: tmux fills in ids like $0 and %3, which sh would otherwise expand.
tmux bind-key -n "${VOICE_KEY:-F5}" run-shell -b \
  "'$ROOT/bin/voice-talk' '#{pane_id}' '#{window_id}' '#{session_id}'"
