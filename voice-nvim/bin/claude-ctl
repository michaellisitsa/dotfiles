#!/bin/sh
# Start Claude Code wired to act on the panes of this tmux session (via tp) by voice. Started
# by ctl-pane on first F6 in a session:
#   VOICE_MODEL            default claude-opus-5-5
#   VOICE_EFFORT           default low
#   VOICE_PERMISSION_MODE  default auto
#   VOICE_CHROME           default 1: start with --chrome; 0 to leave it off
# Extra arguments go straight to `claude`.
set -eu
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
ROOT=$(cd "$(dirname "$self")/.." && pwd)
TP="$ROOT/bin/tp"
NV="$ROOT/bin/nv"

# Render absolute paths into the settings and prompt, so permissions and hooks match exactly.
esc() { printf '%s' "$1" | sed 's/[|&\\]/\\&/g'; }
render() { sed "s|@TP@|$(esc "$TP")|g; s|@NV@|$(esc "$NV")|g" "$1"; }
mkdir -p "$ROOT/.cache"
render "$ROOT/claude/ctl-settings.template.json" > "$ROOT/.cache/ctl-settings.json"
prompt=$(render "$ROOT/claude/ctl-prompt.md")

[ "${VOICE_CHROME:-1}" = 0 ] || set -- --chrome "$@"

exec claude \
  --model "${VOICE_MODEL:-claude-opus-5-5}" \
  --effort "${VOICE_EFFORT:-low}" \
  --permission-mode "${VOICE_PERMISSION_MODE:-auto}" \
  --settings "$ROOT/.cache/ctl-settings.json" \
  --append-system-prompt "$prompt" \
  "$@"
