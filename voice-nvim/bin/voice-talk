#!/bin/sh
# Focus key handler, bound by voice-pane (F5 by default). tmux passes the pane, window and
# session the key was pressed in.
#   From any other pane: remember it and focus the Claude voice pane. Hold Claude Code's
#   push-to-talk key there (F4 in keybindings.json) to talk; release sends (autoSubmit).
#   In the voice pane: go back to the remembered pane.
# In the agents view (footer "enter to return · space to reply") push-to-talk would dictate
# a new background task, so return to the session with Enter first.
set -eu
from=$1 window=$2 session=$3

tagged() { tmux list-panes "$@" -F '#{pane_id} #{@voice}' | awk '$2 == "1" { print $1; exit }'; }
voice=$(tagged -t "$window")
[ -n "$voice" ] || voice=$(tagged -s -t "$session")
if [ -z "$voice" ]; then
  tmux display-message "voice: no Claude voice pane here (run voice-pane)"
  exit 0
fi

if [ "$from" = "$voice" ]; then
  back=$(tmux show-options -pqv -t "$voice" @voice-origin)
  if [ -n "$back" ]; then
    tmux select-window -t "$back" \; select-pane -t "$back" 2>/dev/null || true
  fi
  exit 0
fi

tmux set-option -p -t "$voice" @voice-origin "$from" \; \
  select-window -t "$voice" \; select-pane -t "$voice"
# Only the footer is checked: the same words could appear in the transcript above it.
if tmux capture-pane -p -t "$voice" | awk 'NF' | tail -n 2 | grep -q 'enter to return'; then
  tmux send-keys -t "$voice" Enter
fi
