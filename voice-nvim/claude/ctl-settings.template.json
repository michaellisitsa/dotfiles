{
  "permissions": {
    "allow": [
      "Bash(@TP@)",
      "Bash(@TP@ *)",
      "Bash(@NV@)",
      "Bash(@NV@ *)"
    ],
    "deny": [
      "Bash(tmux)",
      "Bash(tmux *)"
    ]
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "'@TP@' hook prompt", "timeout": 3 }
        ]
      }
    ]
  }
}
